# Copy this file to .env and fill it in.

# Token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty, send /start to the bot and it will reply with your ID.
ALLOWED_USER_IDS=

# PC control commands (/status, /screen, /shutdown, /cmd ...). Enable on the PC itself.
ENABLE_CONTROL=true

# Wake-on-LAN (/wake, /ping). Run on an always-on device in the same LAN as the PC.
# Wake is enabled automatically when WOL_MAC is set.
# MAC of the PC's wired (Ethernet) adapter
WOL_MAC=
# LAN broadcast address, or the router's public address/DDNS name if it forwards UDP
WOL_HOST=192.168.31.255
WOL_PORT=9
# PC's LAN IP for /ping and to report when it has woken up
PC_HOST=

# Optional proxy for Telegram API, e.g. socks5://127.0.0.1:10808 or http://127.0.0.1:10809
PROXY_URL=
